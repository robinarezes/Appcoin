# Base de données PostgreSQL.
#
#   DATABASE_URL — connexion mutualisée, utilisée par l'application
#   DIRECT_URL   — connexion directe, utilisée par les migrations
#
# En créant la base depuis Vercel (voir DEPLOIEMENT.md), les deux valeurs sont
# fournies par le tableau de bord. En local, récupérez-les d'un coup avec :
#
#   npx vercel env pull .env.local
#
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"
DIRECT_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Secret de signature des sessions — générer avec : npx auth secret
AUTH_SECRET="changez-moi"

# Nécessaire derrière un proxy (Vercel le gère automatiquement)
AUTH_TRUST_HOST=true

# Développement local : SQLite
DATABASE_URL="file:./dev.db"

# Production (Vercel + Supabase) : basculer le provider du schéma Prisma sur
# "postgresql" et renseigner les deux adresses fournies par Supabase.
#
#   DATABASE_URL = transaction pooler, port 6543 — utilisé par l'application
#   DIRECT_URL   = session pooler, port 5432    — utilisé par les migrations
#
# Voir DEPLOIEMENT.md pour le détail.
# DATABASE_URL="postgresql://postgres.REF:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.REF:MOTDEPASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Secret de signature des sessions Auth.js — générer avec : npx auth secret
AUTH_SECRET="changez-moi"

# Nécessaire derrière un proxy (Vercel le gère automatiquement)
AUTH_TRUST_HOST=true

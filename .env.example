# Développement local : SQLite
DATABASE_URL="file:./dev.db"

# Production (Vercel + Neon) : basculer le provider du schéma Prisma sur "postgresql"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Secret de signature des sessions Auth.js — générer avec : npx auth secret
AUTH_SECRET="changez-moi"

# Nécessaire derrière un proxy (Vercel le gère automatiquement)
AUTH_TRUST_HOST=true
